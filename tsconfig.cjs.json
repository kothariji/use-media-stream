{
  // The CommonJS half of the build. `moduleResolution: nodenext` refuses to pair with
  // `module: commonjs`, so this pass resolves as a bundler would. That only affects how
  // imports are *found* while emitting — `npm run typecheck` still gates the whole project
  // on nodenext, which is the strict one that enforces explicit .js extensions.
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "lib/cjs"
  }
}
