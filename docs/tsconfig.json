{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    // Mirrors the Vite alias in astro.config.mjs so TypeScript resolves the demo's import
    // to the package source rather than looking for an installed copy.
    "paths": {
      "use-media-stream": ["../src/index.ts"]
    }
  }
}
